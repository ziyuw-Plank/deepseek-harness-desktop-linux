 .../skeleton/ConversationRoot.module.css      | 23 ++++++-------
 .../src/components/dockkit.module.css         | 32 +++++++++----------
 .../tests/app-region-styles.client.spec.ts    | 28 ++++++++--------
 .../src/client/OnboardingSurface.module.css   |  5 +--
 .../tests/app-region-styles.client.spec.ts    |  8 ++---
 packages/client/web/src/base.css              | 28 +++++++++-------
 .../web/tests/base-styles.client.spec.ts      | 27 +++++++++-------
 8 files changed, 87 insertions(+), 72 deletions(-)

diff --git a/apps/desktop/src/main.ts b/apps/desktop/src/main.ts
index 3faf3da3..95684e6c 100644
--- a/apps/desktop/src/main.ts
+++ b/apps/desktop/src/main.ts
@@ -222,9 +222,11 @@ function createWindow(preload: string, show = false, primary = false): BrowserWi
       titleBarOverlay: { height: WINDOWS_TITLEBAR_HEIGHT, color: chromeFallbackFill(),
         symbolColor: nativeTheme.shouldUseDarkColors ? '#f9fafb' : '#0f1115' },
     } : {}),
-    // Linux has no titleBarOverlay; the native frame would spend a whole bar on
-    // the window title, so the window goes frameless and the client's own
-    // chrome draws the controls (the drag regions it already owns).
+    // Linux has no titleBarOverlay path in this shell; the native frame would
+    // spend a whole bar on the window title, so the window goes frameless and
+    // the client's chrome owns drag via base.css mark→drag rules for
+    // data-platform=linux (same marks as darwin). Wayland/X11 both honor
+    // -webkit-app-region on Electron 44+.
     ...(process.platform === 'linux' && primary ? { titleBarStyle: 'hidden' as const } : {}),
     // hiddenInset places traffic lights inside the sidebar; sidebar vibrancy
     // needs a transparent window background to show through the page.
diff --git a/packages/client/ui-conversation/src/client/skeleton/ConversationRoot.module.css b/packages/client/ui-conversation/src/client/skeleton/ConversationRoot.module.css

-/* macOS hiddenInset titlebar: the header block owns the window drag over its
-   own box — title row plus the view tab strip, so the draggable geometry is the
-   header's geometry and no frame band has to match its height. The header marks
-   itself `data-window-drag` (ConversationHeader); below it the title-row clusters
-   subtract their whole boxes, and individual controls are covered by the base.css
-   interactive-element rule. A covering overlay lives beside #root
-   (ui-settings-general), which puts it after this row in document order. */
-:global([data-platform='darwin']) .headerLeading,
-:global([data-platform='darwin']) .headerActions,
-:global([data-platform='darwin']) .headerUtilities,
-:global([data-platform='darwin']) .headerCorner {
+/* Desktop hidden titlebar (macOS hiddenInset + Linux titleBarStyle:hidden): the
+   header block owns the window drag over its own box — title row plus the view
+   tab strip, so the draggable geometry is the header's geometry and no frame
+   band has to match its height. The header marks itself `data-window-drag`
+   (ConversationHeader); below it the title-row clusters subtract their whole
+   boxes, and individual controls are covered by the base.css interactive-element
+   rule. A covering overlay lives beside #root (ui-settings-general), which puts
+   it after this row in document order. */
+:global(html:is([data-platform='darwin'], [data-platform='linux'])) .headerLeading,
+:global(html:is([data-platform='darwin'], [data-platform='linux'])) .headerActions,
+:global(html:is([data-platform='darwin'], [data-platform='linux'])) .headerUtilities,
+:global(html:is([data-platform='darwin'], [data-platform='linux'])) .headerCorner {
   -webkit-app-region: no-drag;
 }
 

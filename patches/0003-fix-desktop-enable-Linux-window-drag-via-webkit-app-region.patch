-:global(html[data-platform='darwin']) .stripTabs,
-:global(html[data-platform='darwin']) .stripChrome,
-:global(html[data-platform='darwin']) .paneBody,
-:global(html[data-platform='darwin']) .float,
-:global(html[data-platform='darwin']) .divider {
+/* Desktop (macOS + Linux): an embedder may pin this surface at the window's top
+   edge (the right sidebar does, in both presentations). The strip row is marked
+   `data-window-drag` in markup (TabPanel), so ui-web base.css's mark→drag rule
+   drags it over its own box; the chip run, the strip-end chrome, the pane body,
+   and the split divider subtract their whole boxes so tabs, controls, content,
+   and the resize grab stay usable wherever they overlap that row. The divider
+   must be named here: it is a plain div, so ui-web base.css's interactive-element
+   subtraction never matches it. A floating pane subtracts its own box the same
+   way, so the strip row never drags the window over it. Hidden surfaces
+   contribute nothing: Blink skips non-visible boxes when it collects draggable
+   regions. */
+:global(html:is([data-platform='darwin'], [data-platform='linux'])) .stripTabs,
+:global(html:is([data-platform='darwin'], [data-platform='linux'])) .stripChrome,
+:global(html:is([data-platform='darwin'], [data-platform='linux'])) .paneBody,
+:global(html:is([data-platform='darwin'], [data-platform='linux'])) .float,
+:global(html:is([data-platform='darwin'], [data-platform='linux'])) .divider {
   -webkit-app-region: no-drag;
 }
 

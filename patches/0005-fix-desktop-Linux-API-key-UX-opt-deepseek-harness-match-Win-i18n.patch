 /** Electron-builder fields asserted by the Desktop release tests. */
 export interface DesktopElectronBuilderConfig {
   readonly appId: string
+  /** Linux uses deepseek-harness so /opt has no spaces; macOS/Windows keep DeepSeek Harness. */
+  readonly productName: 'DeepSeek Harness' | 'deepseek-harness'
   readonly artifactName: string
   readonly protocols: readonly [{ readonly name: 'DeepSeek Harness'; readonly schemes: readonly ['dsh'] }]
   readonly directories: {
@@ -48,6 +50,7 @@ export interface DesktopElectronBuilderConfig {
     readonly category: 'Development'
     readonly executableName: 'deepseek-harness'
     readonly syncDesktopName: true
+    readonly desktop: { readonly entry: { readonly Name: 'DeepSeek Harness' } }
     readonly target: readonly ['AppImage', 'deb']
   }
   readonly deb: {
diff --git a/apps/desktop/scripts/electron-builder-config.mjs b/apps/desktop/scripts/electron-builder-config.mjs
index 90480912..d065c1aa 100644
--- a/apps/desktop/scripts/electron-builder-config.mjs
+++ b/apps/desktop/scripts/electron-builder-config.mjs
@@ -114,7 +114,9 @@ export function createElectronBuilderConfig(
       ...buildVersion === productVersion ? {} : { version: buildVersion },
       ...packaged === undefined ? {} : { dshBuildCommit: packaged.commit, dshBuildDirty: packaged.dirty },
     },
-    productName: 'DeepSeek Harness',
+    // Linux FpmTarget installs under /opt/${sanitizedProductName}; keep the Unix prefix
+    // space-free. Display Name stays "DeepSeek Harness" via linux.desktop.entry below.
+    productName: resolvedPlatform === 'linux' ? 'deepseek-harness' : 'DeepSeek Harness',
     // Unsigned builds carry their own suffix so a shared file can never pass for a release artifact.
     artifactName: `deepseek-harness-\${version}-\${os}-\${arch}${output.suffix}.\${ext}`,
     directories: { output: output.directory },
@@ -270,6 +272,10 @@ export function createElectronBuilderConfig(
       // Matches the desktop file to package.json desktopName, which Electron reports
       // as the Wayland app_id / WM_CLASS so docks group the running window with this entry.
       syncDesktopName: true,
+      // Keep the human-facing Name while productName drives /opt/deepseek-harness.
+      desktop: {
+        entry: { Name: 'DeepSeek Harness' },
+      },
       target: ['AppImage', 'deb'],
     },
     deb: {

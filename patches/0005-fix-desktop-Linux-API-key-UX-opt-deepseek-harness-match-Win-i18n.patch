 .../scripts/electron-builder-config.mjs       |  8 +++++++-
 apps/desktop/src/client/WelcomePage.tsx       | 10 ++++++++--
 apps/desktop/src/main.ts                      |  3 ++-
 apps/desktop/src/preload-welcome.ts           |  2 ++
 apps/desktop/tests/linux-packaging.spec.ts    | 11 ++++++++++-
 .../tests/welcome-renderer.client.spec.tsx    | 15 +++++++++++++++
 packages/bundle/base/cordis.patch.yml         |  3 ++-
 .../src/client/AccountMenu.tsx                |  6 +++++-
 .../tests/account.client.spec.tsx             | 19 +++++++++++++++++++
 10 files changed, 73 insertions(+), 7 deletions(-)

